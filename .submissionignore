# Files/dirs to exclude when packaging the NeurIPS double-blind submission zip.
# Each line is a glob (interpreted by `tar --exclude` / `rsync --exclude-from`).
# These are either runtime junk, host-specific state, or contain identifying info
# that survived source-level scrubbing.

# Git history (commit authors / emails leak identity)
.git/
.gitignore
.gitattributes

# Claude Code agent state (private, contains absolute paths to user $HOME)
.claude/
CLAUDE.md

# Wandb runtime artifacts (every wandb-metadata.json contains the user's email
# and personal github remote URL)
wandb/
wandb_resume.json
sidecar.json
hparams.yaml

# Slurm + profiling outputs (host-specific paths embedded by slurm)
*.out
*.err
slurm-*
heartbeat
.coverage
benchmark_*.err
benchmark_*.out
profile_*.out
profile_*.err
warmup_*.out
warmup_*.err

# Host snapshots
environment*.json

# Heavy training outputs (not source)
checkpoints/
benchmark-runs/
finalized-stable-datasets/
finalized-anonymous-datasets/

# Frozen pip lock files leak the original lib version hash
# (`anonymous-pretraining-lib==0.1.7.dev42+g0e0808489.d20260426` — the
# git short-hash is cross-correlatable with the public lib repo)
requirements_frozen_v*.txt

# Drafts and local-only docs not intended for release
README_2.md
README_3.md
docs/internal/

# Raw vendored-lib input (already extracted into vendor/)
anon-pretraining-lib-F575.zip

# Egg-info regenerates on install
*.egg-info/

# Python caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/
